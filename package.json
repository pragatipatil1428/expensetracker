{
  "name": "spendly-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Spendly — a simple, professional personal expense tracker (React + Vite + Express + MongoDB)",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "npm run dev --prefix server",
    "start:server": "npm start --prefix server",
    "dev:all": "concurrently -n server,client -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "seed": "npm run seed --prefix server"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chart.js": "^4.4.7",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
