# ── Backend (Express) ──────────────────────────────────────────────────────
# Port the API listens on
PORT=5000

# MongoDB connection string
# Local MongoDB (native install): mongodb://127.0.0.1:27017/spendly
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spendly
MONGODB_URI=mongodb://127.0.0.1:27017/spendly

# Secret used to sign JWTs — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Allowed CORS origin (the frontend)
CLIENT_URL=http://localhost:5173
